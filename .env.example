# Cloudflare settings: `pnpm run deploy` uploads this file as the Worker's secrets.
# Other hosts (DROP_HOST=vercel, netlify, deno, vps) take theirs from /docs/self-host/<host>.

# Sign in. Create a GitHub OAuth app with callback <origin>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# GitHub user ids that join as admins, comma-separated: gh api users/<login> --jq .id
DROP_ADMINS=
# wrangler d1 create vitehub-drop
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=vitehub-drop
# D1-over-HTTP hosts also need an account id and an account API token with D1 edit access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Test hosts only: set to 1 temporarily to enable email sign-in for OAuth checks.
# DROP_TEST_SIGNIN=1
