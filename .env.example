# Cloudflare settings: `pnpm run deploy` uploads this file as the Worker's secrets.
# Provider settings and Docker Compose use the same values. See /docs/self-host/<host>.

# Sign in. Create a GitHub OAuth app with callback <origin>/api/auth/callback/github.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Admin emails, comma-separated. Whoever signs in with one of them, verified by the sign-in method, is an admin.
DROP_ADMINS=
# Only these people may sign in, publish, open shared links and files, or use MCP: emails, comma-separated, verified
# by the sign-in method, like DROP_ADMINS. Admins always may. Empty lets anyone with an account in.
DROP_MEMBERS=
# personal (default): drops start private, shared by public link. team: drops start shared with everyone signed in.
DROP_MODE=
# Days a public link stays open: empty for the mode's default (team 7, personal no limit), 0 turns them off.
DROP_PUBLIC_LINK_DAYS=
# Optional build override: cloudflare, vercel, netlify, deno, vps.
# Otherwise use Nitro's preset or provider environment; no signal defaults to Cloudflare.
# Docker always builds for vps.
# DROP_HOST=vps
# Docker/VPS default to local SQLite unless a D1 database id is configured.
# Optional explicit build choice: sqlite or d1. SQLite requires vps.
# DROP_DATABASE=sqlite
# Local database path, read at runtime. Persist .data/ for database, blobs, and KV.
# DROP_DATABASE_URL=file:.data/database/drop.db
# Require active membership for publishing, shared viewing, files, and MCP.
# Native GitHub sign-in requests read:org when set.
# DROP_GITHUB_ORG=your-org
# Optional existing GitHub oauth2-proxy. Requires DROP_GITHUB_ORG.
# Forward X-Auth-Request-Access-Token; Drop validates it against GitHub.
# Native GitHub client credentials above are unnecessary in proxy mode.
# DROP_AUTH_PROXY=true
# Optional proxy cookie to clear on logout; must be Secure, host-only, Path=/.
# DROP_AUTH_PROXY_COOKIE=__Host-drop-auth
# Optional second hostname, served by this same deployment, where apps and HTML docs get their own origin
# (working localStorage, cookies, and history). Keep it outside any login proxy.
# DROP_CONTENT_ORIGIN=https://drop-usercontent.example.com
# Days a review drop lives after its last visit (temporary ones at most 14). 0 keeps every drop.
# DROP_EXPIRY_DAYS=30
# false lets only admins keep drops; true (default) lets owners and their agents too.
# DROP_CUSTOM_EXPIRY=true
# true requires admin approval before a member shares a drop publicly (review at /admin/review).
# DROP_SHARE_APPROVAL=false
# Optional public contact email shown on the abuse page.
# DROP_ABUSE_EMAIL=abuse@example.com
# Terminal Cloudflare deploys: uncomment the database id and name.
# D1 deployments outside Cloudflare: uncomment all four Cloudflare settings.
# npx wrangler d1 create my-drop
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_DATABASE_NAME=my-drop
# Account id and an account API token with D1 edit access.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Test hosts only: set to true temporarily to enable email sign-in for OAuth checks.
# DROP_TEST_SIGNIN=true

# Vercel: create a private Blob store in Storage and copy its token.
# BLOB_READ_WRITE_TOKEN=
# Deno: bucket and endpoint are read at build time; access keys are read at runtime.
# S3_BUCKET=my-drop
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Owner quotas are opt-in. Self-hosted instances leave these unset.
# Everyone gets DROP_DEFAULT_PLAN (free, pro, or unlimited); there are no per-member plans.
# DROP_QUOTAS=true
# DROP_DEFAULT_PLAN=free
# Pro keeps any number of drops unless DROP_PRO_DROPS caps them.
# DROP_PRO_DROPS=500
# DROP_PRO_BYTES=1073741824
# DROP_PRO_WRITES=10000
