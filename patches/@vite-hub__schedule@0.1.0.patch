@@ -0,0 +1,57 @@
+import { cp, mkdir, rm, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+// Nuxt replays the Vite config hooks but does not run the standalone output hooks. Bundle schedules through Nitro
+// so they retain its aliases, auto-imports, and generated service bindings, then give each Netlify function a copy
+// of that server bundle. No HTTP route is needed to invoke a schedule.
+function createNetlifyScheduleNitroModule({ projectRoot, definitions, crons, registry, runtimeImport }) {
+	const names = new Set();
+	const functions = definitions.map((definition) => {
+		const name = `vitehub-schedule-${definition.name.toLowerCase().replace(/[^a-z0-9_-]+/g, "_").replace(/^_+|_+$/g, "") || "schedule"}`;
+		if (names.has(name)) throw new Error(`Netlify schedule function name conflict: ${name}`);
+		names.add(name);
+		return { name, scheduleName: definition.name, cron: crons.get(definition.name) };
+	});
+	return {
+		name: "vitehub/schedule-netlify",
+		async setup(nitro) {
+			const directory = join(projectRoot, ".vitehub/nitro/schedule");
+			const entry = join(directory, "netlify-entry.mjs");
+			await mkdir(directory, { recursive: true });
+			await writeFile(join(directory, "netlify-registry.js"), registry);
+			await writeFile(entry, [
+				`export { default } from ${JSON.stringify(nitro.options.entry)}`,
+				`import registry from './netlify-registry.js'`,
+				`import { executeStaticSchedule, unwrapScheduleDefinition } from ${JSON.stringify(runtimeImport)}`,
+				`const crons = ${JSON.stringify(Object.fromEntries(crons))}`,
+				`export async function runViteHubNetlifySchedule(name) {`,
+				`  const definition = unwrapScheduleDefinition(await registry[name]())`,
+				`  await executeStaticSchedule({ definition, name, cron: crons[name], scheduledAt: new Date() })`,
+				`}`,
+				""
+			].join("\n"));
+			nitro.options.entry = entry;
+			nitro.hooks.hook("compiled", async () => {
+				for (const func of functions) {
+					const directory = join(nitro.options.output.dir, func.name);
+					await rm(directory, { recursive: true, force: true });
+					await cp(nitro.options.output.serverDir, directory, {
+						recursive: true,
+						filter: (source) => source !== join(nitro.options.output.serverDir, "server.mjs")
+					});
+					await writeFile(join(directory, `${func.name}.mjs`), [
+						`import { runViteHubNetlifySchedule } from './main.mjs'`,
+						`export default async function handler() {`,
+						`  await runViteHubNetlifySchedule(${JSON.stringify(func.scheduleName)})`,
+						`  return new Response(null, { status: 204 })`,
+						`}`,
+						`export const config = ${JSON.stringify({ schedule: func.cron, nodeBundler: "none", includedFiles: ["**"] })}`,
+						""
+					].join("\n"));
+				}
+			});
+		}
+	};
+}
+
+export { createNetlifyScheduleNitroModule };
