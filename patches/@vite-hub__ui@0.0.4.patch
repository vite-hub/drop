+import { computed, defineComponent, h, inject, onBeforeUnmount, provide, ref, watch } from "vue";
+//#region src/components/connection-status.ts
+const stateKey = Symbol("ConnectionStatus");
+const labels = {
+	connected: "Connected",
+	connecting: "Connecting",
+	reconnecting: "Reconnecting"
+};
+const ConnectionStatus = defineComponent({
+	name: "ConnectionStatus",
+	props: {
+		status: {
+			required: true,
+			type: String
+		},
+		/** How long, in ms, a lost connection stays "connected" before it shows "reconnecting". Most drops are back sooner. */
+		delay: {
+			default: 1500,
+			type: Number
+		}
+	},
+	setup(props, { slots }) {
+		const joined = ref(props.status === "connected");
+		const lost = ref(false);
+		let timer;
+		watch(() => props.status, (status, previous) => {
+			if (status === "connected") {
+				clearTimeout(timer);
+				joined.value = true;
+				lost.value = false;
+			} else if (previous === "connected") timer = setTimeout(() => lost.value = true, props.delay);
+		});
+		onBeforeUnmount(() => clearTimeout(timer));
+		const state = computed(() => !joined.value ? "connecting" : lost.value ? "reconnecting" : "connected");
+		provide(stateKey, state);
+		return () => h("div", {
+			"data-slot": "connection-status",
+			"data-status": state.value,
+			role: "status"
+		}, slots.default?.({ state: state.value }) ?? [h(ConnectionStatusIndicator), h(ConnectionStatusLabel)]);
+	}
+});
+const ConnectionStatusIndicator = defineComponent({
+	name: "ConnectionStatusIndicator",
+	setup() {
+		const state = inject(stateKey, ref("connecting"));
+		return () => h("span", {
+			"aria-hidden": "true",
+			"data-slot": "connection-status-indicator",
+			"data-status": state.value
+		});
+	}
+});
+const ConnectionStatusLabel = defineComponent({
+	name: "ConnectionStatusLabel",
+	setup(_props, { slots }) {
+		const state = inject(stateKey, ref("connecting"));
+		return () => h("span", { "data-slot": "connection-status-label" }, slots.default?.({ state: state.value }) ?? labels[state.value]);
+	}
+});
+//#endregion
+export { ConnectionStatusIndicator as n, ConnectionStatusLabel as r, ConnectionStatus as t };
