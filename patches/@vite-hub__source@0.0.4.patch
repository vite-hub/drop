+import { a as sourceError, n as normalizeSafeSourcePath } from "./path-Dk4Vqm9k.js";
+//#region src/sources/files.ts
+// Backport of files() from vite-hub/vitehub#2627. The media type covers Markdown only: the released build has no mrmime export.
+function files(entries, options = {}) {
+	const base = options.base ? `${options.base.replace(/\\/g, "/").replace(/\/+$/, "")}/` : "";
+	const items = new Map();
+	for (const [path, content] of Object.entries(entries)) {
+		const portable = path.replace(/\\/g, "/");
+		if (base && !portable.startsWith(base)) throw sourceError(`[vitehub] files() path ${JSON.stringify(path)} does not start with base ${JSON.stringify(options.base)}.`);
+		const key = normalizeSafeSourcePath(portable.slice(base.length));
+		if (items.has(key)) throw sourceError(`[vitehub] files() has two files at ${JSON.stringify(key)}.`);
+		items.set(key, content);
+	}
+	const keys = [...items.keys()].sort((left, right) => left.localeCompare(right));
+	return {
+		name: "files",
+		async getKeys() {
+			return keys;
+		},
+		async getItem(key) {
+			const content = items.get(key);
+			if (content === void 0) throw sourceError(`[vitehub] files() could not find ${JSON.stringify(key)}.`);
+			return { key, path: key, content, mediaType: key.endsWith(".md") ? "text/markdown" : void 0 };
+		}
+	};
+}
+//#endregion
+export { files };
