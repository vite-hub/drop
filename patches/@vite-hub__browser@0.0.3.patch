+import { LeaseStore, MaybePromise, TraceEvent, ViteHubError } from "@vite-hub/runtime";
+import { Browser, BrowserContext, Download, Page } from "playwright-core";
+
+//#region src/types.d.ts
+type BrowserDownload = Download;
+type BrowserEngine = "chromium" | "kitesurf";
+interface BrowserFeatures {
+  liveHandoff: boolean;
+}
+type BrowserIsolation = "process" | "provider" | "trusted-host";
+interface BrowserProviderInfo {
+  features: BrowserFeatures;
+  isolation: BrowserIsolation;
+  name: string;
+}
+interface BrowserProviderOpenOptions {
+  idleTimeoutMs?: number;
+}
+interface BrowserProviderSession<TConnection = unknown> {
+  close(): MaybePromise<void>;
+  connection: TConnection;
+  expiresAt?: Date | string;
+  features?: Partial<BrowserFeatures>;
+  id: string;
+}
+interface BrowserProvider<TConnection = unknown> extends BrowserProviderInfo {
+  open(options?: BrowserProviderOpenOptions): MaybePromise<BrowserProviderSession<TConnection>>;
+}
+interface BrowserControllerLease<TClient> {
+  client: TClient;
+  preservesSessionOnRelease?: boolean;
+  release(): MaybePromise<void>;
+}
+interface BrowserControl<TClient> {
+  readonly client: TClient;
+  release(): Promise<void>;
+}
+interface BrowserControllerContext {
+  provider: BrowserProviderInfo;
+  sessionId: string;
+}
+interface BrowserController<TClient, TConnection = unknown> {
+  attach(connection: TConnection, context: BrowserControllerContext): MaybePromise<BrowserControllerLease<TClient>>;
+  features: {
+    attachExistingSession: boolean;
+  };
+  name: string;
+}
+type BrowserSessionState = "closed" | "controlled" | "handed-off" | "released";
+interface BrowserSessionInfo {
+  expiresAt?: string;
+  features: BrowserFeatures;
+  id: string;
+  provider: string;
+  state: BrowserSessionState;
+}
+interface BrowserSessionRef {
+  readonly audience: string;
+  readonly expiresAt: string;
+  readonly id: string;
+}
+interface BrowserHandoffOptions {
+  audience: string;
+  mode: "live";
+  ttl?: number;
+}
+interface BrowserClaimOptions {
+  audience: string;
+}
+interface BrowserSession<TConnection = unknown> {
+  readonly id: string;
+  attach<TClient>(controller: BrowserController<TClient, TConnection>): Promise<BrowserControl<TClient>>;
+  close(): Promise<void>;
+  handoff(options: BrowserHandoffOptions): Promise<BrowserSessionRef>;
+  inspect(): BrowserSessionInfo;
+}
+interface BrowserClient<TConnection = unknown> {
+  claim(ref: BrowserSessionRef, options: BrowserClaimOptions): Promise<BrowserSession<TConnection>>;
+  open(options?: BrowserProviderOpenOptions): Promise<BrowserSession<TConnection>>;
+}
+interface BrowserPolicy {
+  handoffTtl?: number;
+  idleTimeoutMs?: number;
+}
+interface CreateBrowserOptions<TConnection> {
+  leaseStore?: LeaseStore;
+  policy?: BrowserPolicy;
+  provider: BrowserProvider<TConnection>;
+  trace?: (event: TraceEvent) => MaybePromise<void>;
+}
+interface BrowserPageSession {
+  readonly browser: Browser;
+  readonly context: BrowserContext;
+  readonly id: string;
+  readonly page: Page;
+  close(): Promise<void>;
+  inspect(): BrowserSessionInfo;
+}
+interface BrowserDefinitionBrowser {
+  open(options?: BrowserProviderOpenOptions): Promise<BrowserPageSession>;
+}
+interface BrowserDefinitionContext {
+  browser: BrowserDefinitionBrowser;
+}
+type BrowserDefinitionHandler<TInput = unknown, TResult = unknown> = (input: TInput, context: BrowserDefinitionContext) => MaybePromise<TResult>;
+interface BrowserDefinition<TInput = unknown, TResult = unknown> {
+  run: BrowserDefinitionHandler<TInput, TResult>;
+}
+type BrowserRunResult<TResult = unknown> = [error: null, value: TResult] | [error: ViteHubError<`BROWSER_${string}`>, value: undefined];
+type BrowserDefinitionRegistry = Record<string, BrowserDefinition | (() => Promise<BrowserDefinition | {
+  default?: BrowserDefinition;
+}>)>;
+interface BrowserRuntimeConfig {
+  binding: string;
+  engine?: BrowserEngine;
+  provider?: "cloudflare";
+}
+//#endregion
+export { BrowserRunResult as C, BrowserSessionRef as D, BrowserSessionInfo as E, BrowserSessionState as O, BrowserProviderSession as S, BrowserSession as T, BrowserPageSession as _, BrowserControllerContext as a, BrowserProviderInfo as b, BrowserDefinitionBrowser as c, BrowserDefinitionRegistry as d, BrowserDownload as f, BrowserIsolation as g, BrowserHandoffOptions as h, BrowserController as i, CreateBrowserOptions as k, BrowserDefinitionContext as l, BrowserFeatures as m, BrowserClient as n, BrowserControllerLease as o, BrowserEngine as p, BrowserControl as r, BrowserDefinition as s, BrowserClaimOptions as t, BrowserDefinitionHandler as u, BrowserPolicy as v, BrowserRuntimeConfig as w, BrowserProviderOpenOptions as x, BrowserProvider as y };
