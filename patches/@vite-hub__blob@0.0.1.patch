@@ -0,0 +1,20 @@
+const signatures = [
+	{ segments: [[0, [137, 80, 78, 71, 13, 10, 26, 10]]], type: "image/png" },
+	{ segments: [[0, [255, 216, 255]]], type: "image/jpeg" },
+	{ segments: [[0, [71, 73, 70, 56, 55, 97]]], type: "image/gif" },
+	{ segments: [[0, [71, 73, 70, 56, 57, 97]]], type: "image/gif" },
+	{ segments: [[0, [66, 77]]], type: "image/bmp" },
+	{ segments: [[0, [82, 73, 70, 70]], [8, [87, 69, 66, 80]]], type: "image/webp" },
+	{ segments: [[0, [73, 73, 42, 0]]], type: "image/tiff" },
+	{ segments: [[0, [77, 77, 0, 42]]], type: "image/tiff" },
+	{ segments: [[0, [0, 0, 1, 0]]], type: "image/x-icon" },
+	{ segments: [[0, [37, 80, 68, 70, 45]]], type: "application/pdf" }
+];
+function matchesAt(bytes, offset, signature) {
+	if (offset + signature.length > bytes.length) return false;
+	return signature.every((byte, index) => bytes[offset + index] === byte);
+}
+function detectContentType(bytes) {
+	return signatures.find((signature) => signature.segments.every(([offset, segment]) => matchesAt(bytes, offset, segment)))?.type;
+}
+export { detectContentType };
