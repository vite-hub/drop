diff --git a/dist/ui/styles.css b/dist/ui/styles.css
index 4e7d1b8a7aa65e8f88bb7f0b484f460af31c9da5..1cb2495a752292ccb2e3e90c48ef291a5fd5145e 100644
--- a/dist/ui/styles.css
+++ b/dist/ui/styles.css
@@ -3692,3 +3692,146 @@ button.vh-agent-tool-list__count:focus-visible {
 .vh-primitive-icon[data-icon="workspace"] {
   --vh-primitive-icon-motion: translateY(-1px);
 }
+
+/* Collaboration: AvatarStack, ConnectionStatus, SyncStatus, and the carets of TipTap's CollaborationCaret. */
+@layer components {
+  [data-slot="avatar-stack"] {
+    --vh-avatar-size: 2rem;
+    align-items: center;
+    display: inline-flex;
+    isolation: isolate;
+  }
+
+  [data-slot="avatar-stack"][data-size="sm"] {
+    --vh-avatar-size: 1.5rem;
+  }
+
+  [data-slot="avatar-stack"][data-size="lg"] {
+    --vh-avatar-size: 2.5rem;
+  }
+
+  :is([data-slot="avatar-stack-item"], [data-slot="avatar-stack-count"]) {
+    align-items: center;
+    background: var(--vh-ui-bg-accented);
+    border-radius: 9999px;
+    box-shadow: 0 0 0 2px var(--vh-ui-bg);
+    color: var(--vh-ui-highlighted);
+    display: inline-flex;
+    flex: none;
+    font-size: calc(var(--vh-avatar-size) * 0.4);
+    font-weight: 500;
+    height: var(--vh-avatar-size);
+    justify-content: center;
+    line-height: 1;
+    overflow: hidden;
+    user-select: none;
+    width: var(--vh-avatar-size);
+  }
+
+  :is([data-slot="avatar-stack-item"], [data-slot="avatar-stack-count"]) + :is([data-slot="avatar-stack-item"], [data-slot="avatar-stack-count"]) {
+    margin-inline-start: calc(var(--vh-avatar-size) * -0.15);
+  }
+
+  [data-slot="avatar-stack-count"] {
+    color: var(--vh-ui-muted);
+    font-size: calc(var(--vh-avatar-size) * 0.34);
+  }
+
+  /* The outline ring takes the person's presence color, so each face matches its caret. */
+  [data-slot="avatar-stack"][data-variant="outline"] [data-slot="avatar-stack-item"] {
+    box-shadow: 0 0 0 2px var(--vh-ui-bg), 0 0 0 4px var(--vh-avatar-color, var(--vh-ui-border));
+  }
+
+  [data-slot="avatar-stack"][data-variant="outline"] :is([data-slot="avatar-stack-item"], [data-slot="avatar-stack-count"]) + :is([data-slot="avatar-stack-item"], [data-slot="avatar-stack-count"]) {
+    margin-inline-start: calc(var(--vh-avatar-size) * 0.05);
+  }
+
+  [data-slot="avatar-stack-image"] {
+    height: 100%;
+    object-fit: cover;
+    width: 100%;
+  }
+
+  :is([data-slot="connection-status"], [data-slot="sync-status"]) {
+    align-items: center;
+    color: var(--vh-ui-muted);
+    display: inline-flex;
+    font-size: 0.75rem;
+    gap: 0.375rem;
+    line-height: 1rem;
+    white-space: nowrap;
+  }
+
+  :is([data-slot="connection-status-indicator"], [data-slot="sync-status-indicator"]) {
+    background: var(--vh-ui-dimmed);
+    border-radius: 9999px;
+    flex: none;
+    height: 0.5rem;
+    position: relative;
+    width: 0.5rem;
+  }
+
+  :is([data-slot="connection-status-indicator"][data-status="connected"], [data-slot="sync-status-indicator"][data-status="synchronized"]) {
+    background: var(--vh-ui-success);
+  }
+
+  :is([data-slot="connection-status-indicator"][data-status="reconnecting"], [data-slot="sync-status-indicator"][data-status="synchronizing"]) {
+    background: var(--vh-ui-warning);
+  }
+
+  [data-slot="sync-status-indicator"][data-status="error"] {
+    background: var(--vh-ui-error);
+  }
+
+  :is([data-slot="connection-status"][data-status="reconnecting"], [data-slot="sync-status"][data-status="error"]) {
+    color: var(--vh-ui-highlighted);
+  }
+
+  /* A pending state pings, as Kibo UI's StatusIndicator does. */
+  :is([data-slot="connection-status-indicator"]:not([data-status="connected"]), [data-slot="sync-status-indicator"]:is([data-status="loading"], [data-status="synchronizing"]))::after {
+    animation: vh-status-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
+    background: inherit;
+    border-radius: inherit;
+    content: "";
+    inset: 0;
+    position: absolute;
+  }
+
+  @keyframes vh-status-ping {
+    75%,
+    100% {
+      opacity: 0;
+      transform: scale(2.25);
+    }
+  }
+
+  @media (prefers-reduced-motion: reduce) {
+    :is([data-slot="connection-status-indicator"], [data-slot="sync-status-indicator"])::after {
+      animation: none;
+    }
+  }
+
+  /* TipTap's CollaborationCaret markup, which Realtime's RealtimeCaret also renders. The inline style sets the color. */
+  .collaboration-carets__caret {
+    border-inline: 1px solid;
+    margin-inline: -1px;
+    pointer-events: none;
+    position: relative;
+    word-break: normal;
+  }
+
+  .collaboration-carets__label {
+    border-radius: 0.25rem 0.25rem 0.25rem 0;
+    color: #fff;
+    font-size: 0.75rem;
+    font-style: normal;
+    font-weight: 600;
+    inset-inline-start: -1px;
+    line-height: 1.25;
+    padding: 0.0625rem 0.375rem;
+    position: absolute;
+    top: -1.4em;
+    user-select: none;
+    white-space: nowrap;
+  }
+}
