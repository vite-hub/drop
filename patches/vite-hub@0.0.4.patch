+/* Collaboration: AvatarStack, ConnectionStatus, SyncStatus, and the carets of TipTap's CollaborationCaret. */
+@layer components {
+  [data-slot="avatar-stack"] {
+    --vh-avatar-size: 2rem;
+    align-items: center;
+    display: inline-flex;
+    isolation: isolate;
+  }
+
+  [data-slot="avatar-stack"][data-size="sm"] {
+    --vh-avatar-size: 1.5rem;
