+import { ViteHubError, getViteHubErrorShape } from "@vite-hub/runtime";
+//#region src/errors.ts
+function browserSessionStateError(action, state) {
+	return new ViteHubError("BROWSER_SESSION_STATE", `[vitehub:browser] Cannot ${action} a Browser Session while it is ${state}.`, { details: {
+		action,
+		state
+	} });
+}
+function browserSessionRefError(reason) {
+	return new ViteHubError("BROWSER_SESSION_REF_INVALID", "[vitehub:browser] The Browser Session reference is invalid or no longer claimable.", { details: { reason } });
+}
+function browserLiveHandoffUnsupportedError(provider, controller) {
+	return new ViteHubError("BROWSER_LIVE_HANDOFF_UNSUPPORTED", `[vitehub:browser] Live handoff is not supported by ${controller ? `${provider} with ${controller}` : provider}.`, { details: {
+		provider,
+		...controller ? { controller } : {}
+	} });
+}
+function browserProviderError(provider, operation, options = {}) {
+	return new ViteHubError("BROWSER_PROVIDER_ERROR", `[vitehub:browser] ${provider} could not ${operation}.`, {
+		cause: options.cause,
+		details: {
+			operation,
+			provider,
+			...options.status === void 0 ? {} : { status: options.status }
+		}
+	});
+}
+function browserDefinitionNotFoundError(name) {
+	return new ViteHubError("BROWSER_DEFINITION_NOT_FOUND", `[vitehub:browser] Browser Definition ${JSON.stringify(name)} was not found.`, { details: { name } });
+}
+function browserRuntimeNotConfiguredError() {
+	return new ViteHubError("BROWSER_RUNTIME_NOT_CONFIGURED", "[vitehub:browser] Browser runtime is not configured. Enable Browser through the ViteHub deployment preset.");
+}
+function isBrowserError(value) {
+	return getViteHubErrorShape(value)?.code.startsWith("BROWSER_") === true;
+}
+function toBrowserError(error) {
+	if (isBrowserError(error)) return error;
+	return new ViteHubError("BROWSER_RUNTIME_ERROR", (error instanceof Error ? error.message : String(error)) || "[vitehub:browser] Browser Definition execution failed.", { cause: error });
+}
+//#endregion
+export { browserSessionRefError as a, browserRuntimeNotConfiguredError as i, browserLiveHandoffUnsupportedError as n, browserSessionStateError as o, browserProviderError as r, toBrowserError as s, browserDefinitionNotFoundError as t };
