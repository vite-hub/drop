--- /dev/null
+++ b/dist/runtime/nitro-cache.js
@@ -0,0 +1,27 @@
+import { a as normalizeKey } from "../utils2-Dsb9P4_2.js";
+import { kv } from "@vite-hub/kv";
+//#region src/runtime/nitro-cache.ts
+async function unwrap(pending) {
+	const [error, value] = await pending;
+	if (error) throw error;
+	return value;
+}
+/** Unstorage driver over the app's default KV store, for Nitro's `cache` mount. */
+function createKVCacheDriver(options = {}) {
+	const prefix = `${normalizeKey(options.base ?? "nitro-cache")}:`;
+	const key = (name) => prefix + normalizeKey(name);
+	return {
+		name: "vitehub-kv",
+		options,
+		hasItem: (name) => unwrap(kv.has(key(name))),
+		getItem: (name) => unwrap(kv.get(key(name))),
+		setItem: (name, value, opts) => unwrap(kv.set(key(name), value, opts)),
+		removeItem: (name) => unwrap(kv.del(key(name))),
+		async getKeys(base) {
+			return (await unwrap(kv.keys(key(base)))).map((name) => name.slice(prefix.length));
+		},
+		clear: (base) => unwrap(kv.clear(key(base)))
+	};
+}
+//#endregion
+export { createKVCacheDriver as default };
