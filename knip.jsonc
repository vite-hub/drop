{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // code-along's page imports CodeMirror and marked by name from the import map in its page.html, not from node_modules.
  "ignoreIssues": { "skills/code-along/assets/app.js": ["unlisted"] },
  "workspaces": {
    ".": {
      // The Nuxt plugin finds app/ and server/{api,middleware,plugins,routes}. These are the other entries: files
      // nuxt.config names by path, ViteHub's conventions (auth, databases, realtime, schedules), MCP, scripts, and tests.
      "entry": [
        "server/auth.ts",
        "server/console-authorize.ts",
        "server/handlers/*.ts",
        "server/realtime/*.ts",
        "server/schedules/*.ts",
        "server/databases/default/index.ts",
        "server/mcp/index.ts",
        // ViteHub Content's definition, found by convention.
        "server/content.ts",
        // ViteHub's sitemap entries (`seo.sitemap`), found by convention.
        "server/sitemap.ts",
        // Tags in content/docs/**/*.md (`::roles-table`) render these; knip doesn't read the Markdown.
        "app/components/docs/md/*.vue",
        // Nuxt auto-imports these viewer controls; their references are template/runtime driven.
        "app/components/viewer/ViewerDevice.vue",
        "app/components/viewer/ViewerDeviceButton.vue",
        "app/components/viewer/ViewerToolbar.vue",
        "app/utils/devices.ts",
        "scripts/*.{ts,mjs}",
        "test/**/*.test.mjs",
        "test/e2e/*.mjs",
        // Run by hand against a local Worker with D1 fixtures.
        "test/quotas/*-runtime.mjs",
        // Launched by ssr-fetch.test.mjs in a Node subprocess.
        "test/auth/ssr-fetch-runtime.mjs",
        "skills/**/*.js",
        // `pnpm doctor` loads it with --config.
        "doctor.config.ts",
        // The contract between review.js and the browser extension, which imports its types.
        "shared/review-host.ts",
      ],
      "project": [
        "app/**/*.{ts,vue,css}",
        "server/**/*.ts",
        "shared/**/*.ts",
        "scripts/**/*.{ts,mjs}",
        "test/**/*.{ts,mjs}",
        "skills/**/*.js",
        "*.ts",
      ],
      "ignoreDependencies": [
        // nuxt/schema re-exports this package from the installed Nuxt 5 nightly.
        "@nuxt/schema-nightly",
        // nuxt.config `css` names these packages; knip doesn't resolve a package's stylesheet entry.
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "@fontsource/instrument-serif",
        // Nuxt Icon reads the icon collections by name at build time.
        "@iconify-json/mingcute",
        "@iconify-json/simple-icons",
        // Served from node_modules/medium-zoom/dist through nitro.publicAssets, never imported.
        "medium-zoom",
        // `nuxt typecheck` runs it.
        "vue-tsc",
        // `nuxt` is installed as an alias of nuxt-nightly, which knip reports under its real name (`#app` in app/error.vue).
        "nuxt-nightly",
      ],
    },
    // @vite-hub/drop, the Nuxt module that sites install.
    "packages/nuxt": {
      "entry": ["src/nuxt.ts", "src/runtime/review.client.ts", "test/types/consumer.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      // `nuxt` is an alias of nuxt-nightly for the types of `#app`; `vitest` comes with vite-plus.
      "ignoreDependencies": ["nuxt", "nuxt-nightly", "vitest"],
    },
    // @vite-hub/drop-extension, the browser extension. WXT finds entrypoints/ by convention.
    "packages/extension": {
      "entry": ["entrypoints/**/*.{ts,vue}", "harness/*.mjs", "test/**/*.ts"],
      "project": ["entrypoints/**/*.{ts,vue}", "components/**/*.vue", "lib/**/*.ts", "assets/**/*.ts", "harness/*.mjs", "test/**/*.ts"],
      "ignoreDependencies": [
        // assets/main.css imports these stylesheets, and @nuxt/ui/vite reads the icon collection by name.
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "@iconify-json/mingcute",
      ],
    },
  },
}
