    "@vite-hub/content": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/content@fa476a05309b793cab521538e3e18a9de0a0dd35",
    "@vite-hub/database": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/database@fa476a05309b793cab521538e3e18a9de0a0dd35",
