  "name": "vitehub-drop",
  "version": "0.1.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "build": "nuxt build && node scripts/migrate-workers-builds.mjs",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "knip": "knip",
    "db:generate": "vitehub database generate",
    "db:migrate": "vitehub database migrate",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "preview": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json && wrangler dev --config .output/server/wrangler.json --enable-containers=false --port 8788",
    "doctor": "vite-doctor . --config doctor.config.ts --no-cache --severity warn --max-warnings 0",
    "test": "vp test",
    "fmt": "vp fmt",
    "check": "vp check",
    "test:e2e:deployed": "node test/e2e/deployed-flow.mjs",
    "typecheck": "nuxt typecheck",
    "prepare": "vp config"
  },
