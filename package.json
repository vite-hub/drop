  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.10",
    "knip": "6.41.0",
    "modern-screenshot": "4.7.0",
    "nitro": "3.0.261029-rc",
    "playwright": "1.64.1",
    "typescript": "^6.0.3",
    "vite-doctor": "0.1.1",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.18.0",
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Drop data and sign-in records. Migrations run before deployment."
      },
      "BLOB": {
        "description": "Private files. Enable R2 in your Cloudflare account first."
      },
      "KV": {
        "description": "Rendered Markdown and request cache."
      },
      "BROWSER": {
        "description": "PNG code images. Enable Browser Run in your Cloudflare account first."
      },
      "GITHUB_CLIENT_ID": {
        "description": "GitHub OAuth app client id. [Callback setup](https://drop.vitehub.dev/docs/self-host#github)."
      },
      "GITHUB_CLIENT_SECRET": {
        "description": "Client secret from the same GitHub OAuth app."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Generate with `openssl rand -base64 32`."
      },
      "DROP_ADMINS": {
        "description": "Your GitHub user id: `gh api users/<login> --jq .id`. Comma-separated for multiple admins."
      }
    }
  }
}
