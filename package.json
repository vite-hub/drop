{
  "name": "vitehub-drop",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "mkdir -p .vitehub/data/database && drizzle-kit migrate --config .vitehub/database/drizzle.config.ts",
    "db:migrate:d1": "wrangler d1 migrations apply \"${CLOUDFLARE_D1_DATABASE_NAME}\" --remote --directory server/databases/migrations",
    "db:migrate:remote": "cp -r server/databases/migrations .output/server/ && wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json --secrets-file .env",
    "dev": "nuxt dev",
    "postinstall": "vitehub types prepare && nuxt prepare",
    "preview": "cp -r server/databases/migrations .output/server/ && wrangler d1 migrations apply DB --local --config .output/server/wrangler.json && wrangler dev --config .output/server/wrangler.json --enable-containers=false --port 8788",
    "test:e2e:deployed": "node test/e2e/deployed-flow.mjs",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.7",
    "@comark/html": "0.6.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.60",
    "@nuxt/ui": "4.11.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "beautiful-mermaid": "1.1.3",
    "better-auth": "1.7.7",
    "confbox": "^0.3.1",
    "drizzle-orm": "0.45.2",
    "entities": "^8.1.0",
    "evlog": "2.30.1",
    "h3": "2.0.1",
    "h3-mcp": "0.2.0",
    "jose": "^6.2.12",
    "medium-zoom": "1.1.0",
    "mrmime": "^2.0.1",
    "nanotar": "^0.3.0",
    "nitro-mcp-toolkit": "0.4.0",
    "nuxt": "npm:nuxt-nightly@5.0.0-29766097.1e475df9",
    "pretty-bytes": "^7.2.0",
    "shiki": "^4.5.0",
    "tailwindcss": "4.3.3",
    "ufo": "^1.6.4",
    "valibot": "^1.4.2",
    "vite-hub": "https://pkg.pr.new/vite-hub/vitehub/vite-hub@016f1ef5a26920cd38ee252626163bf57be4f494",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "drizzle-kit": "^0.31.10",
    "nitro": "3.0.260610-beta",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9",
    "wrangler": "4.148.0"
  }
}
