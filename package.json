{
  "name": "vitehub-drop",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "knip": "knip",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "vitehub db migrate",
    "db:migrate:d1": "node --env-file-if-exists=.env scripts/migrate-d1.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "deploy": "pnpm db:migrate:remote && node scripts/deploy-cloudflare.mjs",
    "dev": "nuxt dev",
    "postinstall": "vitehub types prepare && nuxt prepare",
    "preview": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json && wrangler dev --config .output/server/wrangler.json --enable-containers=false --port 8788",
    "doctor": "vite-doctor . --config doctor.config.ts --no-cache --severity warn --max-warnings 0",
    "test": "vp test",
    "fmt": "vp fmt",
    "check": "vp check",
    "test:e2e:deployed": "node test/e2e/deployed-flow.mjs",
    "typecheck": "nuxt typecheck",
    "prepare": "vp config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/lib-storage": "3.1156.0",
    "@aws-sdk/s3-presigned-post": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@better-auth/oauth-provider": "1.7.10",
    "@better-auth/stripe": "1.7.10",
    "@comark/html": "0.8.1",
    "@comark/vue": "0.8.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@iconify-json/mingcute": "^1.2.8",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.60",
    "@nuxt/ui": "4.11.0",
    "@shikijs/langs": "4.5.0",
