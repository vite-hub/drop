    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "prepack": "vp pack",
    "test": "vp test"
  },
  "dependencies": {
    "@nuxt/kit": "^4.1.0"
  },
  "devDependencies": {
    "@vite-hub/forge": "https://pkg.pr.new/vite-hub/vitehub/@vite-hub/forge@a3c412d4d0fac46f69fcf4a08778d14d48163ff6",
    "nuxt": "npm:nuxt-nightly@5.0.0-2610292252-da55a91",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "nuxt": ">=4.0.0"
  }
}
