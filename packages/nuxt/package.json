{
  "name": "@vite-hub/drop",
  "version": "0.1.0",
  "description": "Connect a Nuxt site to Drop: load review.js, and name the build of a preview so Drop can find its pull request.",
  "keywords": [
    "drop",
    "nuxt",
    "nuxt-module",
    "preview",
    "review"
  ],
  "homepage": "https://drop.vitehub.dev/docs/sites",
  "bugs": "https://github.com/vite-hub/drop/issues",
  "license": "Apache-2.0",
  "author": "onmax <maximogarciamtnez@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vite-hub/drop.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./nuxt": {
      "types": "./dist/nuxt.d.mts",
